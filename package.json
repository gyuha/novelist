{
	"name": "novelist",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.2",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "pnpm -r --parallel --if-present dev",
		"check": "biome check .",
		"typecheck": "pnpm -r --if-present typecheck",
		"test": "pnpm -r --if-present --filter '!@novelist/e2e' test",
		"build": "pnpm -r --if-present build",
		"e2e": "pnpm --filter @novelist/e2e --if-present test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/node": "^24.19.2",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	}
}
